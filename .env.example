# ─── Trustee Referral Monitor — Environment Variables ────────────────────────
# Copy this file to .env for local development (never commit the real .env!)

# Optional: Override target site URL (default: https://trustee.io)
# Use this to point the monitor at the mock server for self-testing
TARGET_URL=https://trustee.io

# Optional: Maximum pages to crawl (default: 15)
MAX_PAGES=15

# Optional: Healthchecks.io ping URL for uptime monitoring
# Create a check at https://healthchecks.io and paste the URL here.
# Format: https://hc-ping.com/<your-uuid>
# If not set, healthcheck pings are silently skipped.
HEALTHCHECK_URL=
