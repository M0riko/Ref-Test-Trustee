# ─── Trustee Referral Monitor — Environment Variables ────────────────────────
# Copy this file to .env for local development (never commit the real .env!)

# Optional: Override target site URL (default: https://trustee.io)
TARGET_URL=https://trustee.io

# Optional: Maximum pages to crawl (default: 15)
MAX_PAGES=15

# Healthchecks.io ping URL for uptime monitoring
HEALTHCHECK_URL=https://hc-ping.com/47ab8778-8c70-41f0-9a1e-318f546c67a4

# Telegram Bot notifications
# 1. Create a bot via @BotFather -> get TELEGRAM_BOT_TOKEN
# 2. Send /start to your bot, then get TELEGRAM_CHAT_ID via @userinfobot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
